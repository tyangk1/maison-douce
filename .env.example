# ─────────────────────────────────────────────────────────────────────────────
# Maison Douce — environment variables
# Copy to .env for local development. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Prisma)
# Local dev uses SQLite (zero-config). For Supabase/PostgreSQL production:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Client-safe: NO
DATABASE_URL="file:./dev.db"

# Session signing secret (min 24 chars). Generate: openssl rand -hex 32
# Client-safe: NO
AUTH_SECRET="change-me-to-a-long-random-string-min-24-chars"

# Seed-only admin credentials (local/dev). The seed script reads these to
# create the admin account. In production, create the admin manually and do
# NOT set a default password.
# Client-safe: NO
ADMIN_EMAIL="admin@maisondouce.test"
ADMIN_PASSWORD="MaisonAdmin!2026"

# Public site name (optional)
# Client-safe: YES
NEXT_PUBLIC_SITE_NAME="Maison Douce"

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (optional — only needed if you switch DATABASE_URL to Postgres and
# want Supabase-managed storage for product imagery)
# ─────────────────────────────────────────────────────────────────────────────

# Purpose: Supabase project URL
# Client-safe: YES
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Purpose: Supabase anonymous/public API key (client features only)
# Client-safe: YES
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Purpose: server-side administrative Supabase operations (never exposed)
# Client-safe: NO
# SUPABASE_SERVICE_ROLE_KEY=""

# Purpose: direct (non-pooled) DB connection for Prisma migrations
# Client-safe: NO
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# Payments
# The checkout currently uses the built-in MOCK provider (no env vars needed).
# To enable Stripe later, implement StripePaymentProvider in src/lib/payment.ts
# and add:
# Client-safe: NO
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
